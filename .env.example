NODE_ENV=development
LOG_LEVEL=info

APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# These match the database started by `pnpm db:start`
DATABASE_URL=postgresql://hireflow@localhost:5433/hireflow
TEST_DATABASE_URL=postgresql://hireflow@localhost:5433/hireflow_test

# Make each one with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-value-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-another-long-random-value-32-chars

COOKIE_DOMAIN=
COOKIE_SECURE=false

# In development, leave SMTP_HOST empty. Emails are then saved in .mail-preview/ and not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HireFlow <no-reply@hireflow.local>

RATE_LIMIT_USER_PER_MIN=100
RATE_LIMIT_AUTH_PER_MIN=10

# How many days after applying to send the follow-up reminder
FOLLOW_UP_DAYS=7

# Where resumes are saved. In production, point this at a disk that survives a restart.
UPLOAD_DIR=uploads
