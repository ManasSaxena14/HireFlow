NODE_ENV=development
LOG_LEVEL=info

APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# Matches the private cluster started by `pnpm db:start`
DATABASE_URL=postgresql://hireflow@localhost:5433/hireflow
TEST_DATABASE_URL=postgresql://hireflow@localhost:5433/hireflow_test

# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-value-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-another-long-random-value-32-chars

COOKIE_DOMAIN=
COOKIE_SECURE=false

# Leave SMTP_HOST empty in development to write emails to .mail-preview/ instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HireFlow <no-reply@hireflow.local>

RATE_LIMIT_USER_PER_MIN=100
RATE_LIMIT_AUTH_PER_MIN=10

# Days after applying before the automatic follow-up reminder
FOLLOW_UP_DAYS=7
