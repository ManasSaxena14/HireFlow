NODE_ENV=development
LOG_LEVEL=info

APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# These match the database started by `pnpm db:start`
DATABASE_URL=postgresql://hireflow@localhost:5433/hireflow
TEST_DATABASE_URL=postgresql://hireflow@localhost:5433/hireflow_test

# Sign-up and sign-in run in Neon Auth. On your computer, `pnpm dev` starts a stand-in for it
# at this address, so you need no internet or Neon project. Emails and codes go to .mail-preview/.
# To use the real Neon Auth instead, paste the Auth URL from the Neon console here
# (Settings, Better Auth, Project Info). The API and the web site both read it.
NEON_AUTH_BASE_URL=http://localhost:4300/neondb/auth
# Web site only. Signs the session cookie. Make it with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace-with-a-long-random-value-at-least-32-chars
# Set to false to sign in without the email code on your computer. Neon's live setting is separate.
LOCAL_AUTH_VERIFY_EMAIL=true

# Signs interview booking links and file download links. Make it with: openssl rand -base64 48
LINK_SECRET=replace-with-a-long-random-value-at-least-32-chars

# In development, leave SMTP_HOST empty. Emails are then saved in .mail-preview/ and not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HireFlow <no-reply@hireflow.local>

RATE_LIMIT_USER_PER_MIN=100
RATE_LIMIT_AUTH_PER_MIN=10

# How many days after applying to send the follow-up reminder
FOLLOW_UP_DAYS=7

# Where resumes are saved. In production, point this at a disk that survives a restart.
UPLOAD_DIR=uploads

# How many proxies sit in front of the API. 1 for one host. Use 2 when the web host passes
# requests on to an API on another host, or every visitor shares one sign-in limit.
TRUST_PROXY_HOPS=1
