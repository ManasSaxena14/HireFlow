{
  "name": "@hireflow/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json; tsc -p tsconfig.build.json --watch --preserveWatchOutput & PORT=4000 node --watch-path=dist --watch-preserve-output dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=../../.env node_modules/node-pg-migrate/bin/node-pg-migrate.js --migrations-dir migrations --ignore-pattern \"(\\\\..*)|(.* [0-9]+\\\\..*)\"",
    "openapi": "node dist/openapi/write-openapi.js"
  },
  "dependencies": {
    "@hireflow/shared": "workspace:*",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/throttler": "^6.7.1",
    "helmet": "^8.3.0",
    "jose": "6.2.17",
    "kysely": "^0.29.8",
    "luxon": "^3.7.2",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hireflow/config": "workspace:*",
    "@nestjs/testing": "^12.4.0",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "node-pg-migrate": "^9.0.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "typescript": "~5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
